# ─── Core ────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgres://medusa:medusa_dev@localhost:5432/medusa_db
REDIS_URL=redis://localhost:6379

# Generadas con `openssl rand -hex 32`
JWT_SECRET=change_me_in_production
COOKIE_SECRET=change_me_in_production

# CORS (separados por coma) — en producción apuntan a tu dominio real.
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:3000

# ─── Cloudflare R2 (S3-compatible) ───────────────────────
# Crea un bucket y genera credenciales en el dashboard de R2.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rtbunker-media
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# URL pública (custom domain o pub-XXXX.r2.dev)
R2_PUBLIC_URL=https://media.example.com

# ─── Stripe ──────────────────────────────────────────────
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend ──────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=Tienda <pedidos@example.com>
RESEND_REPLY_TO=hola@example.com
# Email del admin que recibe el aviso de cada pedido nuevo (si vacío → RESEND_REPLY_TO)
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# ─── URLs ────────────────────────────────────────────────
# Backend/admin (CTA "Abrir en admin" de los emails) y storefront (CTA mockups)
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000/es

# ─── PayPal (método de pago, opcional) ───────────────────
# Si PAYPAL_CLIENT_ID está vacío, el provider NO se registra y el checkout
# funciona solo con Stripe. Crear app en developer.paypal.com (sandbox/live).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_AUTO_CAPTURE=true
# Webhook: registrar {MEDUSA_BACKEND_URL}/hooks/payment/paypal_paypal en PayPal
PAYPAL_WEBHOOK_ID=

# ─── Meilisearch ─────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=change_me_in_production
MEILISEARCH_INDEX=products

# ─── Worker mode ─────────────────────────────────────────
# shared (default) | server | worker. En producción se separa server/worker.
MEDUSA_WORKER_MODE=shared
