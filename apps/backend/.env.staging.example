# ───────────────────────────────────────────────────────────────
# RT Bunker — BACKEND (Medusa) · plantilla de STAGING
# Copia a `.env` en el servidor y rellena los valores reales.
# Reemplaza STAGING_DOMAIN por tu dominio (p.ej. staging.rtbunker.com).
# ───────────────────────────────────────────────────────────────

NODE_ENV=production
MEDUSA_WORKER_MODE=shared

# ─── Base de datos / Redis (en el servidor) ────────────────────
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/medusa
REDIS_URL=redis://localhost:6379

# ─── Secrets (genera valores largos y aleatorios) ──────────────
JWT_SECRET=CAMBIA_ESTO_por_un_secreto_largo
COOKIE_SECRET=CAMBIA_ESTO_por_otro_secreto_largo
# TTL de sesión (opcional; default 30 días). 24h = 86400000
# SESSION_TTL_MS=86400000

# ─── CORS (dominios del storefront y del admin) ────────────────
# Admin se sirve en el mismo backend → su propia URL.
STORE_CORS=https://STAGING_DOMAIN
ADMIN_CORS=https://api.STAGING_DOMAIN,https://STAGING_DOMAIN
AUTH_CORS=https://STAGING_DOMAIN,https://api.STAGING_DOMAIN

# URL pública del backend (para el admin y los links de email/static)
MEDUSA_BACKEND_URL=https://api.STAGING_DOMAIN
# URL del storefront (success_url de Stripe, links de email…)
STOREFRONT_URL=https://STAGING_DOMAIN

# ─── Stripe (MODO TEST en staging) ─────────────────────────────
STRIPE_API_KEY=sk_test_...
# Webhook de PAGOS (endpoint en Stripe → https://api.STAGING_DOMAIN/hooks/payment/stripe)
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook de SUSCRIPCIONES del Club (endpoint → https://api.STAGING_DOMAIN/webhooks/stripe-subscriptions)
STRIPE_SUBSCRIPTIONS_WEBHOOK_SECRET=whsec_...

# ─── Ficheros: Cloudflare R2 (imágenes de producto) ────────────
# IMPRESCINDIBLE para que se vean las fotos fuera de tu máquina.
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=rtbunker-media
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.STAGING_DOMAIN   # o el dominio público del bucket
R2_REGION=auto
# Compatibilidad AWS SDK ≥3.700 con R2:
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# ─── Meilisearch (buscador) ────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=MASTER_KEY_de_meili
MEILISEARCH_INDEX=products

# ─── Emails: Resend (en staging, redirige a un buzón de prueba) ─
RESEND_API_KEY=re_...
RESEND_FROM=RT Bunker <pedidos@STAGING_DOMAIN>   # dominio verificado en Resend, o el sandbox
RESEND_REPLY_TO=info@rtbunker.com
# Redirige TODOS los emails a este buzón en staging (no spamear a clientes):
RESEND_DEV_REDIRECT_TO=tu-buzon-de-pruebas@gmail.com
