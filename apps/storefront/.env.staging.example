# ───────────────────────────────────────────────────────────────
# RT Bunker — STOREFRONT (Next.js) · plantilla de STAGING
# Copia a `.env` (o variables del build) en el servidor.
# Reemplaza STAGING_DOMAIN por tu dominio (p.ej. staging.rtbunker.com).
# ───────────────────────────────────────────────────────────────

# ─── Backend Medusa ────────────────────────────────────────────
# Pública (la usa el navegador) e interna (server-side). En un mismo
# servidor pueden ser la misma URL pública.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.STAGING_DOMAIN
MEDUSA_BACKEND_URL=https://api.STAGING_DOMAIN
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...   # publishable key del sales channel

# ─── URL pública del propio storefront ─────────────────────────
NEXT_PUBLIC_BASE_URL=https://STAGING_DOMAIN
NEXT_PUBLIC_DEFAULT_REGION=es

# ─── 🔒 STAGING: bloquea buscadores (noindex + robots disallow) ─
# Quitar esta línea en producción real.
NEXT_PUBLIC_SITE_NOINDEX=true

# ─── Stripe (clave PÚBLICA, modo TEST en staging) ──────────────
NEXT_PUBLIC_STRIPE_KEY=pk_test_...

# ─── Meilisearch (clave de BÚSQUEDA, no la master) ─────────────
MEILISEARCH_HOST=https://search.STAGING_DOMAIN   # o la interna si no es pública
MEILISEARCH_SEARCH_KEY=search_key_de_meili
MEILISEARCH_INDEX=products

# ─── Revalidación on-demand (webhook desde el backend) ─────────
REVALIDATE_SECRET=CAMBIA_ESTO_por_un_secreto
