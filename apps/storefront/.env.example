# ─── Public (expuestas al navegador) ─────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...   # se obtiene en `npm run seed` del backend
NEXT_PUBLIC_DEFAULT_REGION=es
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_KEY=pk_test_...
# WhatsApp: número internacional sin "+" (vacío = botón flotante oculto)
NEXT_PUBLIC_WHATSAPP_NUMBER=34XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_TEXT=Hola RT Bunker, tengo una consulta
# PayPal: Client ID (vacío = checkout solo con Stripe)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ─── Server only ─────────────────────────────────────────
MEDUSA_BACKEND_URL=http://localhost:9000
REVALIDATE_SECRET=change_me_in_production

# ─── Meilisearch (server-side search proxy) ──────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_SEARCH_KEY=change_me_in_production
MEILISEARCH_INDEX=products
