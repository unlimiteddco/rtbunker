# WordPress / WooCommerce origen
WP_BASE_URL=https://tienda-vieja.example.com

# WooCommerce REST API keys (Settings → Advanced → REST API → Add Key)
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternativa: WP Application Password (cualquiera de los dos pares vale)
# WP_USERNAME=admin
# WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Destino: Medusa Admin API
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=change_me

# R2 destino para los media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rtbunker-ecom
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
