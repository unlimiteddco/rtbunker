# Compartido por docker-compose y por las apps en local
# Copia este archivo a .env y rellena los valores reales.

# ─── Postgres ────────────────────────────────────────────
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa_dev
POSTGRES_DB=medusa_db
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────
REDIS_PORT=6379

# ─── Meilisearch ─────────────────────────────────────────
MEILI_MASTER_KEY=change_me_in_production
MEILI_PORT=7700

# ─── Backend (Medusa) ────────────────────────────────────
BACKEND_PORT=9000
BACKEND_PUBLIC_URL=http://localhost:9000

# ─── Storefront (Next.js) ────────────────────────────────
STOREFRONT_PORT=8000
NEXT_PUBLIC_BASE_URL=http://localhost:8000
