{
  "name": "rtbunker",
  "private": true,
  "version": "0.1.0",
  "description": "Headless ecommerce — Medusa 2.0 backend + Next.js 15 storefront",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace apps/backend run dev",
    "dev:storefront": "npm --workspace apps/storefront run dev",
    "dev": "npm-run-all -p dev:backend dev:storefront",
    "build:backend": "npm --workspace apps/backend run build",
    "build:storefront": "npm --workspace apps/storefront run build",
    "build": "npm run build:backend && npm run build:storefront",
    "lint": "npm --workspaces --if-present run lint",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "docker:up": "docker compose up -d postgres redis meilisearch",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.0.0"
}
